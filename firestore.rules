rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /portfolios/{portfolioId} {
      // Anyone can view a portfolio (that's the point of the QR code)
      allow read: if true;

      // Anyone can create a new portfolio (no auth in this MVP flow)
      allow create: if isValidPortfolio(request.resource.data);

      // Only rating fields may be changed after creation, and only via
      // the exact increment path the app performs in submitRating()
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['ratingSum', 'ratingCount', 'ratingAverage']);

      allow delete: if false;

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if request.resource.data.value is int
                       && request.resource.data.value >= 1
                       && request.resource.data.value <= 5;
        allow update, delete: if false;
      }
    }

    function isValidPortfolio(data) {
      return data.title is string
          && data.phone is string
          && data.ratingSum == 0
          && data.ratingCount == 0;
    }
  }
}
